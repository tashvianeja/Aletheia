{
  "manifest_version": 3,
  "name": "Aletheia",
  "version": "0.1.0",
  "description": "Local privacy checks before you share files, form fields, permissions, or consent.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "cookies",
    "webRequest",
    "declarativeNetRequest",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Aletheia \u2014 local privacy checks"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "schema-validator.js",
        "content/dom-utils.js",
        "content/forms.js",
        "content/uploads.js",
        "content/consent.js",
        "content/documents.js",
        "content/tracking.js"
      ],
      "css": [
        "content/guardian.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/cmp_adapters.json",
        "schema/*.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
