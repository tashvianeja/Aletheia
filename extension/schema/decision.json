{
  "$defs": {
    "DecisionFinding": {
      "additionalProperties": false,
      "description": "One row in the widget: a warning triangle, a green tick or a neutral note.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "severity": {
          "default": "warn",
          "enum": [
            "warn",
            "ok",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "DecisionFinding",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "IGNORE",
        "INFORM",
        "INTERVENE"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "risk": {
      "maximum": 1,
      "minimum": 0,
      "title": "Risk",
      "type": "number"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "headline": {
      "default": "",
      "title": "Headline",
      "type": "string"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DecisionFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "subject": {
      "default": "",
      "title": "Subject",
      "type": "string"
    },
    "destination": {
      "default": "",
      "title": "Destination",
      "type": "string"
    },
    "rationale": {
      "items": {
        "type": "string"
      },
      "title": "Rationale",
      "type": "array"
    },
    "actions": {
      "items": {
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "action_labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Action Labels",
      "type": "object"
    },
    "primary_action": {
      "default": "",
      "title": "Primary Action",
      "type": "string"
    },
    "tertiary_action": {
      "default": "",
      "title": "Tertiary Action",
      "type": "string"
    },
    "auto_action": {
