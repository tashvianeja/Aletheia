    "layout": {
      "default": "body_first",
      "enum": [
        "body_first",
        "findings_first"
      ],
      "title": "Layout",
      "type": "string"
    },
    "default_action": {
      "default": "cancel",
      "title": "Default Action",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "outcome",
    "risk",
    "explanation"
